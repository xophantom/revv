DATABASE_URL="postgresql://USER:PASS@HOST:5432/revv?schema=public"
AUTH_SECRET="generate-with: openssl rand -base64 32"
BLOB_READ_WRITE_TOKEN=""
# Optional. Set it to turn on magic-link login (and rotate AUTH_SECRET to drop existing sessions).
# Without it, login is email-only with no verification.
AUTH_RESEND_KEY=""
# Sender on a domain verified in Resend (onboarding@resend.dev only delivers to the account owner)
AUTH_EMAIL_FROM="Revv <login@seu-dominio.com>"

# Daily alert e-mail: Vercel Cron calls /api/cron/alert-digest at 11:00 UTC (08:00 in São Paulo)
# sending "Authorization: Bearer $CRON_SECRET". Without CRON_SECRET or a Resend key it stays off.
# Generate with: openssl rand -hex 32 (left empty here so a copied example never enables the route).
CRON_SECRET=""
# Optional. Resend key for alert e-mails; empty falls back to AUTH_RESEND_KEY.
RESEND_API_KEY=""
# Optional. Sender for alert e-mails; empty falls back to AUTH_EMAIL_FROM, e.g. "Revv <alertas@seu-dominio.com>".
# onboarding@resend.dev only delivers to the Resend account owner: use a verified domain for anyone else.
ALERT_EMAIL_FROM=""
# Optional. Base URL for links in e-mails; empty falls back to AUTH_URL, then https://$VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=""
# Who gets the alert e-mail. With magic link on, accounts with a confirmed e-mail; with the e-mail-only
# login (no verification, anyone can create an account for any address) only the addresses listed
# here, comma-separated, e.g. "voce@exemplo.com".
ALERT_EMAIL_TO=""

