DATABASE_URL="postgresql://USER:PASS@HOST:5432/revv?schema=public"
AUTH_SECRET="generate-with: openssl rand -base64 32"
BLOB_READ_WRITE_TOKEN=""
# Optional. Set it to turn on magic-link login (and rotate AUTH_SECRET to drop existing sessions).
# Without it, login is email-only with no verification.
AUTH_RESEND_KEY=""
# Sender on a domain verified in Resend (onboarding@resend.dev only delivers to the account owner)
AUTH_EMAIL_FROM="Revv <login@seu-dominio.com>"

