generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  sessions       Session[]
  vehicles       Vehicle[]
  alertDigestAt  DateTime? // last alert e-mail sent
  alertDigestKey String? // which alerts it listed, so an unchanged list isn't re-sent daily
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Vehicle {
  id           String              @id @default(cuid())
  userId       String
  name         String
  plate        String?
  make         String?
  model        String?
  year         Int?
  engine       String?
  color        String?
  currentKm    Int                 @default(0)
  photoKey     String?
  photoUrl     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  spec         VehicleSpec?
  maintenances MaintenanceRecord[]
  upgrades     Upgrade[]
  attachments  Attachment[]
  customAlerts CustomAlert[]
  fuelRecords  FuelRecord[]

  @@index([userId])
}

model VehicleSpec {
  id        String   @id @default(cuid())
  vehicleId String   @unique
  data      Json
  updatedAt DateTime @updatedAt
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

enum MaintenanceCategory {
  OIL
  FILTERS
  BRAKES
  TIRES
  REVISION
  SUSPENSION
  ELECTRICAL
  FLUIDS
  OTHER
}

enum UpgradeCategory {
  EXHAUST
  WHEELS
  ECU
  SUSPENSION
  AESTHETIC
  AUDIO
  BRAKES
  OTHER
}

enum AttachmentKind {
  image
  pdf
}

model MaintenanceRecord {
  id          String              @id @default(cuid())
  vehicleId   String
  date        DateTime
  km          Int
  category    MaintenanceCategory
  specRuleIds String[]            @default([]) // spec rules this service covered (e.g. ["engineOil", "airFilter"]) for precise alerts
  specRuleId  String? // legacy single-rule tag, backfilled into specRuleIds; unused, drop in a later migration
  title       String
  workshop    String?
  costCents   Int                 @default(0)
  notes       String?
  createdAt   DateTime            @default(now())
  vehicle     Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([vehicleId])
}

model Upgrade {
  id          String          @id @default(cuid())
  vehicleId   String
  date        DateTime
  name        String
  category    UpgradeCategory
  costCents   Int             @default(0)
  supplier    String?
  notes       String?
  createdAt   DateTime        @default(now())
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([vehicleId])
}

model Attachment {
  id            String             @id @default(cuid())
  vehicleId     String
  maintenanceId String?
  upgradeId     String?
  kind          AttachmentKind
  url           String
  key           String
  fileName      String
  mime          String
  size          Int
  caption       String?
  createdAt     DateTime           @default(now())
  vehicle       Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenance   MaintenanceRecord? @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  upgrade       Upgrade?           @relation(fields: [upgradeId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model CustomAlert {
  id           String    @id @default(cuid())
  vehicleId    String
  label        String
  dueKm        Int?
  dueDate      DateTime?
  done         Boolean   @default(false)
  repeatMonths Int? // recurring: completing it moves the due date this many months ahead (IPVA = 12)
  repeatKm     Int? // recurring by distance: completing it moves the due km ahead
  dueDay       Int? // day of month a monthly repeat aims for, so 31/01 → 28/02 → 31/03 doesn't stick on the 28th
  createdAt    DateTime  @default(now())
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

enum FuelType {
  GASOLINE
  ETHANOL
  DIESEL
  OTHER
}

model FuelRecord {
  id        String   @id @default(cuid())
  vehicleId String
  date      DateTime
  km        Int
  volumeMl  Int // liters × 1000, kept whole like money
  costCents Int      @default(0) // total paid
  fuel      FuelType @default(GASOLINE)
  fullTank  Boolean  @default(true) // consumption is measured between full tanks
  station   String?
  notes     String?
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date])
}
